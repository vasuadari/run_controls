alias s:= switch

# switch:
#   nix run nix-darwin -- switch --flake ~/.run_controls/.config/darwin#
switch:
    brew trust --formula atlassian/acli/acli
    nix run nix-darwin -- build --flake ~/.run_controls/.config/darwin#work
    sudo ./result/activate 2>&1 | tee /tmp/nix-darwin-activate.log
    sudo nix-env -p /nix/var/nix/profiles/system --set ./result

# Debug switch - shows verbose output
switch-debug:
    brew trust --formula atlassian/acli/acli
    nix run nix-darwin -- build --flake ~/.run_controls/.config/darwin#work --show-trace
    sudo HOMEBREW_BUNDLE_DEBUG=1 ./result/activate
    sudo nix-env -p /nix/var/nix/profiles/system --set ./result

nflake:
  $EDITOR ~/.run_controls/.config/darwin/flake.nix

nhome:
  $EDITOR ~/.run_controls/.config/darwin/home.nix
